rules_version = '2';
// Firebase 콘솔 > Firestore Database > 규칙 탭에 통째로 붙여넣고 "게시"하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    // 멤버 = /api/login에서 이름 + 공용 비밀번호 확인 후 발급된 토큰을 가진 사람 (토큰 안에 member 이름이 들어 있음)
    function member() {
      return request.auth != null
        && request.auth.token.member is string
        && request.auth.token.member.size() > 0;
    }

    // 멤버 프로필: 누구나(멤버) 보기, 본인 것만 쓰기
    match /users/{uid} {
      allow read: if member();
      allow write: if member() && request.auth.uid == uid;
    }

    // 장소: 멤버만 보기·추가. 사진(images, imageIdx)은 누구나 바꿀 수 있고, 삭제는 등록한 사람만
    match /places/{placeId} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      // 기본 가게(seed-01 등)도 같은 규칙으로 등록돼요
      allow update: if member()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['images', 'imageIdx'])
            // 조회 기록: 본인 칸(views.내uid)만 추가할 수 있어요
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                && request.resource.data.views.diff(resource.data.get('views', {})).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if member() && resource.data.createdBy == request.auth.uid;
    }

    // 오늘 약속(식사조인): 주최자만 만들고 지울 수 있어요.
    // 참여·취소는 본인 칸(joined.내uid)만 바꿀 수 있고, 정원(capacity)을 넘을 수 없어요.
    match /meetups/{meetupId} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 10
        && request.resource.data.joined.size() == 0;
      allow update: if member()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined.diff(resource.data.joined).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.joined.size() <= resource.data.capacity;
      allow delete: if member() && resource.data.hostUid == request.auth.uid;
    }

    // 기록: 멤버만 보기·추가. 수정·삭제는 쓴 사람만
    match /reviews/{reviewId} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5;
      allow update, delete: if member() && resource.data.uid == request.auth.uid;
    }
  }
}
